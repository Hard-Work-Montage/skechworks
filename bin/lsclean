#!/bin/sh
# Keep exactly one Sketchyworks in Finder's Open With menu.
#
# LaunchServices registers every app bundle it finds, and a build leaves several
# behind: the build products copy, a Debug copy from each test run, and anything
# unzipped while testing a release. They pile up as extra Sketchyworks copies, one per
# version, in every Open With menu. Only /Applications should be launchable.
#
# Driven off the registration dump rather than a list of paths, because the copies
# turn up wherever a build happened to run — a scratch directory, an old checkout,
# a folder that no longer exists. A path that is already gone still needs the
# unregister call; the entry outlives the bundle.
set -e

LSR=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
[ -x "$LSR" ] || exit 0

# Register the one that should win FIRST. Adding a document type only takes
# effect once LaunchServices re-reads the bundle, and it will not do that on its
# own just because the file changed — a new type sat in the Info.plist and never
# appeared in an Open With menu.
"$LSR" -f /Applications/Sketchyworks.app >/dev/null 2>&1 || true

"$LSR" -dump 2>/dev/null \
  | grep -oE '/[^ ]*Sketchyworks[^ ]*\.app' \
  | sort -u \
  | grep -v '^/Applications/' \
  | while read -r stale; do
      "$LSR" -u "$stale" >/dev/null 2>&1 || true
    done

echo "registered: $(# Register the one that should win FIRST. Adding a document type only takes
# effect once LaunchServices re-reads the bundle, and it will not do that on its
# own just because the file changed — a new type sat in the Info.plist and never
# appeared in an Open With menu.
"$LSR" -f /Applications/Sketchyworks.app >/dev/null 2>&1 || true

"$LSR" -dump 2>/dev/null \
  | grep -oE '/[^ ]*Sketchyworks[^ ]*\.app' | sort -u | tr '\n' ' ')"
