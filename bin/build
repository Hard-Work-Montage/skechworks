#!/bin/sh
# Build Sketchyworks.app (Release) and leave it runnable.
#
# Signing matters more than it looks. Two things bite:
#
# 1. xcodebuild signs the app and the embedded SketchyworksCore.framework as separate
#    identities, and dyld then refuses to load the framework ("different Team IDs").
#    Signing the whole bundle in one pass, inside-out, gives it one identity.
#
# 2. An ad-hoc signature is rejected by Gatekeeper (`spctl -a` says so). The app still
#    launches when you point at it directly, but a *document* bound to it via the
#    per-file LaunchServices binding gets challenged — macOS shows "could not verify
#    ... free of malware" naming the DOCUMENT, and strips the binding. So the launch
#    binding is only safe once the app carries a real Developer ID signature.
#
# Override the identity with SW_SIGN_ID; falls back to ad-hoc if no Developer ID
# is installed, in which case bin/build warns and the binding should stay off.
set -e
cd "$(dirname "$0")/.."

SIGN_ID="${SW_SIGN_ID:-$(security find-identity -v -p codesigning 2>/dev/null \
  | grep 'Developer ID Application' | head -1 | sed 's/.*"\(.*\)"/\1/')}"

# A real identity must carry a secure timestamp or notarization rejects the build
# ("The signature does not include a secure timestamp"). Ad-hoc can't have one.
TIMESTAMP="--timestamp"

if [ -z "$SIGN_ID" ]; then
  SIGN_ID="-"
  TIMESTAMP="--timestamp=none"
  echo "warning: no Developer ID found; signing ad-hoc."
  echo "         Gatekeeper will reject this build, so documents bound to it will be"
  echo "         challenged on open. Run 'sw unclaim' on your library if that bites."
fi

xcodegen generate

# The exit status has to be xcodebuild's, not grep's. Piped into a filter that
# ends in `|| true`, a compile error printed its message and the script carried
# straight on — signing, and then INSTALLING, the bundle left over from the last
# build that worked. You get a green run, a fresh timestamp on /Applications, and
# yesterday's code inside it.
set -o pipefail
xcodebuild \
  -project Sketchyworks.xcodeproj \
  -scheme Sketchyworks \
  -configuration Release \
  -derivedDataPath build \
  "$@" | grep -E "error:|BUILD" || {
    echo "build failed — nothing installed, /Applications still has the last good build."
    exit 1
  }
set +o pipefail

APP="build/Build/Products/Release/Sketchyworks.app"
[ -d "$APP" ] || { echo "build failed: no app bundle"; exit 1; }

# Inside-out: framework first, then the app that embeds it.
codesign --force --options runtime $TIMESTAMP --sign "$SIGN_ID" \
  "$APP/Contents/Frameworks/SketchyworksCore.framework" >/dev/null 2>&1
codesign --force --options runtime $TIMESTAMP --sign "$SIGN_ID" \
  "$APP" >/dev/null 2>&1

codesign --verify --deep --strict "$APP" 2>&1 && echo "signature ok: $SIGN_ID"
# The whole verdict, not the last line of it. `tail -1` printed the origin and
# swallowed the word "rejected" above it, so a build Gatekeeper turns down read
# exactly like one it accepts.
GATEKEEPER=$(spctl -a -vv -t exec "$APP" 2>&1 || true)
echo "gatekeeper: $(echo "$GATEKEEPER" | tr '\n' ' ')"
if echo "$GATEKEEPER" | grep -q rejected; then
  echo "warning: Gatekeeper rejects this build. It launches, but a document that"
  echo "         carries a quarantine flag is challenged on open and offered to the"
  echo "         Trash by name. Run bin/notarize before working in one."
fi

echo "built $APP"

# Land it where double-click finds it. Every build replaces /Applications, so
# "the latest" and "the one in Applications" are always the same app — a
# running instance keeps its old copy alive until it relaunches.
rm -rf /Applications/Sketchyworks.app
ditto "$APP" /Applications/Sketchyworks.app
echo "installed /Applications/Sketchyworks.app"

# Only the installed copy should be launchable — see bin/lsclean.
bin/lsclean >/dev/null 2>&1 || true
