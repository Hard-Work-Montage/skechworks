#!/bin/sh
# Turn the raw 1024px masters into proper macOS icons, then build AppIcon.icns.
#
# The masters are a rounded tile sitting on a dark vignette that fills the square.
# macOS does NOT mask app icons — it draws exactly the pixels you hand it — so
# shipping those verbatim gave a dark square with the artwork inset inside, which
# reads as a bordered tile everywhere the icon appears.
#
# So: crop the tile out of the vignette, mask its corners to transparent, and sit it
# on a 1024 canvas at 824px — the size Apple's grid expects, with the surrounding
# margin left for the shadow.
#
#   bin/make-appicon --process           reprocess masters, then build from white
#   bin/make-appicon --process purple    ... and build from a different colourway
#   bin/make-appicon                     just rebuild the .icns
set -e
cd "$(dirname "$0")/.."

ICONS=App/Sketchyworks/Icons
RAW=${SW_ICON_MASTERS:-"$HOME/Downloads"}
TILE=824
RADIUS=185

# Normalises whatever is in Icons/ onto Apple's grid, in place.
if [ "$1" = "--process" ]; then
  python3 - "$ICONS" "$TILE" "$RADIUS" <<'NORMALISE'
import subprocess, glob, os, sys, shutil
icons, TILE, RADIUS = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
CANVAS = 1024
backup = "/tmp/sw-icon-src"
os.makedirs(backup, exist_ok=True)
mask = "/tmp/sw-mask.png"
# CopyOpacity reads luminance, so white = opaque. Drawing the shape in black
# yields an entirely transparent icon, which is a confusing five minutes.
subprocess.run(["magick", "-size", f"{TILE}x{TILE}", "xc:black", "-fill", "white",
                "-draw", f"roundrectangle 0,0,{TILE-1},{TILE-1},{RADIUS},{RADIUS}", mask], check=True)

for src in sorted(glob.glob(os.path.join(icons, "*.png"))):
    name = os.path.basename(src)
    stash = os.path.join(backup, name)
    if not os.path.exists(stash):
        shutil.copy(src, stash)
    # Threshold the alpha first: these masters carry a soft glow, and trimming on
    # raw alpha measures the glow rather than the tile — which is why every
    # colourway came out a different size and off-centre.
    box = subprocess.run(["magick", stash, "-alpha", "extract", "-threshold", "92%",
                          "-trim", "-format", "%w %h %X %Y", "info:"],
                         capture_output=True, text=True).stdout.split()
    w, h, x, y = (int(v.replace("+", "")) for v in box)
    side = max(w, h)                       # square it around the tile's centre
    x0 = max(0, x + w // 2 - side // 2)
    y0 = max(0, y + h // 2 - side // 2)
    side = min(side, CANVAS - x0, CANVAS - y0)
    subprocess.run(["magick", stash, "-crop", f"{side}x{side}+{x0}+{y0}", "+repage",
                    "-resize", f"{TILE}x{TILE}!", "/tmp/sw-tile.png"], check=True)
    subprocess.run(["magick", "/tmp/sw-tile.png", mask, "-alpha", "off",
                    "-compose", "CopyOpacity", "-composite", "/tmp/sw-masked.png"], check=True)
    subprocess.run(["magick", "-size", f"{CANVAS}x{CANVAS}", "xc:none", "/tmp/sw-masked.png",
                    "-gravity", "center", "-composite", src], check=True)
    print(f"  {name:14s} {side}px tile -> {TILE} centred in {CANVAS}")
NORMALISE
  shift
fi

SRC="$ICONS/${1:-white}.png"
[ -f "$SRC" ] || SRC="$ICONS/white.png"
OUT="App/Sketchyworks/AppIcon.iconset"
rm -rf "$OUT"; mkdir -p "$OUT"
for s in 16 32 128 256 512; do
  sips -z $s $s "$SRC" --out "$OUT/icon_${s}x${s}.png" >/dev/null
  sips -z $((s*2)) $((s*2)) "$SRC" --out "$OUT/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$OUT" -o App/Sketchyworks/AppIcon.icns
rm -rf "$OUT"
echo "AppIcon.icns <- $(basename "$SRC")"
