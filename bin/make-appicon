#!/bin/sh
# Build AppIcon.icns from one of the Icons/*.png masters.
#
# The bundled icon is what Finder and the Dock show before the app runs. The
# in-app picker swaps NSApp.applicationIconImage at runtime, which a signed
# bundle can't persist — so the default has to be baked in here.
set -e
cd "$(dirname "$0")/.."
SRC="${1:-App/Accomplice/Icons/gradient.png}"
OUT="App/Accomplice/AppIcon.iconset"
rm -rf "$OUT"; mkdir -p "$OUT"
for s in 16 32 128 256 512; do
  sips -z $s $s "$SRC" --out "$OUT/icon_${s}x${s}.png" >/dev/null
  sips -z $((s*2)) $((s*2)) "$SRC" --out "$OUT/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$OUT" -o App/Accomplice/AppIcon.icns
rm -rf "$OUT"
echo "AppIcon.icns <- $(basename "$SRC")"
